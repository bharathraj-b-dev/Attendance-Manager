<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/layoutDashboardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="90dp">

        <!-- Top Greeting Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Good evening, Bharath 👋" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:text="Personal Attendance Tracker" />
        </LinearLayout>

        <!-- Overall Attendance Hero Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="6dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_hero"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#C7D2FE"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="YOUR ATTENDANCE" />

                    <TextView
                        android:id="@+id/tvOverallStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:background="@drawable/bg_badge_safe"
                        android:textColor="@color/status_safe_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Safe" />
                </RelativeLayout>

                <!-- Big Percentage -->
                <TextView
                    android:id="@+id/tvOverallPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_inverse"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    tools:text="79.29%" />

                <!-- Counters Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:background="#20FFFFFF"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#C7D2FE"
                            android:textSize="12sp"
                            android:text="@string/present_label" />

                        <TextView
                            android:id="@+id/tvOverallPresent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_inverse"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="268" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#30FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#C7D2FE"
                            android:textSize="12sp"
                            android:text="@string/absent_label" />

                        <TextView
                            android:id="@+id/tvOverallAbsent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_inverse"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="70" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#30FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#C7D2FE"
                            android:textSize="12sp"
                            android:text="@string/marked_label" />

                        <TextView
                            android:id="@+id/tvOverallMarked"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_inverse"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="338" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Health Summary Advice -->
                <TextView
                    android:id="@+id/tvOverallAdvice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_inverse"
                    android:textSize="13sp"
                    tools:text="✓ 4 subjects safe  •  ⚠️ 2 subjects need attention" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GLOBAL NEXT CLASS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNextClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="NEXT CLASS" />

                    <TextView
                        android:id="@+id/tvNextClassBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:background="@drawable/bg_badge_unmarked"
                        android:textColor="@color/status_unmarked_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:text="Upcoming" />
                </RelativeLayout>

                <!-- Subject Title -->
                <TextView
                    android:id="@+id/tvNextSubjectName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Database Management Systems" />

                <!-- Date / Time -->
                <TextView
                    android:id="@+id/tvNextClassTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="12 Oct 2026 • 08:00 AM" />

                <!-- Current Subject Attendance -->
                <TextView
                    android:id="@+id/tvNextCurrentPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    tools:text="Current attendance: 94.64%" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/divider" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="What happened?" />

                <!-- 2-Row Spacious Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNextAttend"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="✓ Attend"
                            android:textColor="@color/text_inverse"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/status_safe"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNextBunk"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="✕ Bunk"
                            android:textColor="@color/text_inverse"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/status_critical"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNextOd"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:text="◉ On Duty (OD)"
                        android:textColor="@color/text_inverse"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/status_on_duty"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ATTENDANCE UPDATE REQUIRED / PENDING CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPendingAttention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/status_warning"
            app:strokeWidth="1.5dp"
            app:cardBackgroundColor="@color/surface"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/status_warning_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:text="⚠️ ATTENDANCE UPDATE REQUIRED" />

                    <TextView
                        android:id="@+id/tvPendingCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="2 pending classes" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPendingSubjectName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Computer Architecture" />

                <TextView
                    android:id="@+id/tvPendingClassTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    tools:text="12 Oct • 10:00 AM — You haven't marked what happened." />

                <!-- 2-Row Spacious Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPendingAttend"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="✓ Attend"
                            android:textColor="@color/text_inverse"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/status_safe"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPendingBunk"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="✕ Bunk"
                            android:textColor="@color/text_inverse"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/status_critical"
                            app:cornerRadius="12dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPendingOd"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:text="◉ On Duty (OD)"
                        android:textColor="@color/text_inverse"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/status_on_duty"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/layoutEmptyDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_nav_import"
                app:tint="@color/primary"
                android:contentDescription="Import" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:text="No Attendance Data Yet" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:text="Optionally import initial attendance from DigiCampus or manage your attendance locally." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyImport"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Open DigiCampus Tab"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>